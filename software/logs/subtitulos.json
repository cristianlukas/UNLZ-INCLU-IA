{
    "items": [
        {
            "id": "c532ada0-bfb4-4c18-9d53-f4e808edcfb6",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 110,
            "t1_ms": 3110,
            "t_server_ms": 1780924780200,
            "text": "La secividad de metod\u00f3quicas de medici\u00f3n y ensayos"
        },
        {
            "id": "e1fd696e-034a-445a-943f-688486751d7d",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780924784623,
            "text": "efectivas industriales."
        },
        {
            "id": "6d6d89ec-4a1d-445f-97b9-60953dd19c56",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 140,
            "t1_ms": 3140,
            "t_server_ms": 1780924789603,
            "text": "Otros autores sin culinar en definirla"
        },
        {
            "id": "10429592-7547-446b-ac70-2bc2bbb3d0d0",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 80,
            "t1_ms": 2080,
            "t_server_ms": 1780924800671,
            "text": "Sindo la hecha de video, \u00bfok?"
        },
        {
            "id": "0bd5f932-b552-40a0-8c6d-32d85b5d28e6",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 50,
            "t1_ms": 3510,
            "t_server_ms": 1780924805911,
            "text": "y en un intento de ampliar la definici\u00f3n proponendo las"
        },
        {
            "id": "032b27aa-72a6-476a-8ba9-5aba2b746493",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3200,
            "t_server_ms": 1780924811084,
            "text": "La metrolog\u00eda es la sensibilidad que tiene un pro objeto aire."
        },
        {
            "id": "08d54189-047e-4dc6-8302-c353e053c289",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 340,
            "t1_ms": 3340,
            "t_server_ms": 1780924816245,
            "text": "Las escas las de menida, los sistemas de unidad."
        },
        {
            "id": "85023a14-ff84-44f2-a89b-ac8ea57b7aa7",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 4000,
            "t_server_ms": 1780924820879,
            "text": "as\u00ed como la evoluci\u00f3n de lo anterior"
        },
        {
            "id": "d3ba4847-8103-437d-8a1a-a22eb11ce3fa",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 4000,
            "t_server_ms": 1780924826163,
            "text": "la valoraci\u00f3n de la calidad de las mediciones y su mejor aconse..."
        },
        {
            "id": "0261a6c0-ef3a-42c7-9559-009fd87f32c5",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780924831041,
            "text": "El desarrollo tecnol\u00f3gico y el Minister social."
        },
        {
            "id": "2a6fe6dd-e8fd-49dc-809b-568542ac3254",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 1000,
            "t_server_ms": 1780924835564,
            "text": "y la calidad de vida."
        },
        {
            "id": "03d53193-fdd3-43db-8836-c841f9400030",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3280,
            "t_server_ms": 1780924840694,
            "text": "vivian tres categor\u00edas cada una de ellas con diferente."
        },
        {
            "id": "7c338ea3-d710-47cd-ad43-afb8dc9cfe40",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780924845695,
            "text": "nombres de complejidad y es artitud."
        },
        {
            "id": "13e19fbc-c80a-440e-a3ab-dd658c84c566",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 370,
            "t1_ms": 3370,
            "t_server_ms": 1780924850780,
            "text": "La metrolog\u00eda cient\u00edfica, el nivel m\u00e1s alto."
        },
        {
            "id": "58185e95-798d-49ad-97c7-8bd7dde464d6",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780924855798,
            "text": "de la vida y de sumar del inmediato."
        },
        {
            "id": "35715e8d-fdc9-4744-9eec-1e9778070cc4",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 1140,
            "t1_ms": 3460,
            "t_server_ms": 1780924866900,
            "text": "metrograf\u00eda industrial, asegurar la..."
        },
        {
            "id": "1f4a7f68-3b73-4b37-b76d-90e0aa70e447",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780924872396,
            "text": "las mediciones que influyen sobre las paredes de las transacciones."
        },
        {
            "id": "efa6c50b-8c60-43f0-979c-51c440b063e4",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 240,
            "t1_ms": 3040,
            "t_server_ms": 1780924877228,
            "text": "La metrolog\u00eda es rolemente."
        },
        {
            "id": "27ea7eaf-3bd2-4fa0-bda3-1899e7a72159",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780924888613,
            "text": "y la sincima se te va a hermana"
        },
        {
            "id": "5ae5375c-701c-4bb1-b260-7ab819699231",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780924893671,
            "text": "en la mesi\u00f3n permite conocer de forma condiciva."
        },
        {
            "id": "a585ebbf-7dd2-4b71-aa84-ae8dae975fa0",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2800,
            "t_server_ms": 1780924899023,
            "text": "las propiedades f\u00edsicas y t\u00edmigas de los objetos."
        },
        {
            "id": "709110ff-5ee5-46c6-b56d-aded73a5c5ba",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780924904044,
            "text": "siempre he estado \u00edntimamente ligado al..."
        },
        {
            "id": "8a39e1d4-0fd6-4c36-ba90-e4c9eb708dec",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3080,
            "t_server_ms": 1780924909423,
            "text": "Las mediciones son un medio para escribir los fen\u00f3menes naturales"
        },
        {
            "id": "4705e55c-0b3c-4655-89fe-d2fbbe4a5305",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 4000,
            "t_server_ms": 1780924914799,
            "text": "de forma cuantitativa. Para mostrar la importancia"
        },
        {
            "id": "9afcd71e-2616-4943-a5cf-61342de19536",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780924919932,
            "text": "alguna de las cosas que no podr\u00edan llevarse a la"
        },
        {
            "id": "0dcf9321-dd42-4c9d-823c-4fad1f5a964e",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780924929257,
            "text": "3, la meterolog\u00eda"
        },
        {
            "id": "8556e52f-af68-4a14-ac55-45a0d7d0fee8",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780924934322,
            "text": "y eso afecta a nuestras econ\u00f3micas privadas."
        },
        {
            "id": "79399475-05ef-4ced-860f-3e7fd523a7b3",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3120,
            "t_server_ms": 1780924939636,
            "text": "y de la fuerza de seguridad con sus consecuencias de colonia"
        },
        {
            "id": "c069b6f7-3b54-4d8e-9de5-53a7980c28bf",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780924945092,
            "text": "para que son en techas de rompa por cenitaje de algo"
        },
        {
            "id": "2aafcd1a-a29e-4f64-9f40-f010432b60fa",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780924950033,
            "text": "presi\u00f3n de nom\u00e1ticos, etc."
        },
        {
            "id": "6816a5b4-9209-4287-b352-144f0412130f",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 1000,
            "t_server_ms": 1780924954888,
            "text": "recerios a la metrolog\u00eda."
        },
        {
            "id": "57c0950b-f26c-4189-9c13-cd36dbc66ba4",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3200,
            "t_server_ms": 1780924960256,
            "text": "el comercio en mercado y las leches que lo regulan."
        },
        {
            "id": "98e84af0-53cb-44d7-b184-56383cf88291",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 1000,
            "t_server_ms": 1780924964875,
            "text": "de las comunes."
        },
        {
            "id": "bec79d70-2e4e-4d28-86a0-716ff0d93ca4",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 110,
            "t1_ms": 2110,
            "t_server_ms": 1780924969253,
            "text": "Ok"
        },
        {
            "id": "d3de496f-84d1-4112-90b7-661fe2306351",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 1230,
            "t1_ms": 3230,
            "t_server_ms": 1780924978726,
            "text": "Precisamente en el sistema de reunidades."
        },
        {
            "id": "43ae14f6-1abc-45a3-883a-4d4dc84d7d41",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780924983574,
            "text": "de la vez significa magnitud."
        },
        {
            "id": "1c79e879-e7b2-4808-b6c1-fa71a412cdb3",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 590,
            "t1_ms": 2590,
            "t_server_ms": 1780924988417,
            "text": "As\u00ed que de como de cantidad"
        },
        {
            "id": "69538e4e-6aaf-45e8-a4f9-7318a27d36a5",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3040,
            "t_server_ms": 1780924993432,
            "text": "sin producir la noci\u00f3n de proceso."
        },
        {
            "id": "dac5aee0-d4ab-43b1-b2a7-915a1f071071",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 1000,
            "t_server_ms": 1780925002112,
            "text": "Ah, ah, ah."
        },
        {
            "id": "396c760f-99d9-4e17-b94d-b61653896e0f",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 20,
            "t1_ms": 2020,
            "t_server_ms": 1780925006603,
            "text": "4 sistemas"
        },
        {
            "id": "3b1f6e5c-cbdc-47d5-8bf5-65892ccc146d",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 80,
            "t1_ms": 2080,
            "t_server_ms": 1780925011387,
            "text": "Sistema en prida"
        },
        {
            "id": "8ba5c007-64bc-45ff-8d55-7a16b1259239",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780925016221,
            "text": "y lo vamos a medir"
        },
        {
            "id": "e58863fe-4d68-4215-976d-054b77fb2b63",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780925021049,
            "text": "y salemos para medir."
        },
        {
            "id": "299a1870-d480-41ce-b164-aec4def637b5",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3200,
            "t_server_ms": 1780925026545,
            "text": "Sistima de unidad o patron de referencia es de su les"
        },
        {
            "id": "32627690-b75b-4a4a-9cfd-45ab7a15c2e6",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780925031707,
            "text": "incluida en el sistema de mesi\u00f3n as\u00ed una"
        },
        {
            "id": "f2bd10ec-dfed-403c-84f7-e41332622d3c",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 460,
            "t1_ms": 2460,
            "t_server_ms": 1780925036670,
            "text": "Pues aquella est\u00e1 grabada en..."
        },
        {
            "id": "d40da4db-ae38-4f40-b753-1e9917e570a7",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 1420,
            "t1_ms": 3420,
            "t_server_ms": 1780925042214,
            "text": "otro sistema. Enganza a la menci\u00f3n."
        },
        {
            "id": "e7983645-6bec-4a90-91b6-dbad74a47352",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2920,
            "t_server_ms": 1780925047550,
            "text": "autom\u00e1ticas una vez se con un software del termino."
        },
        {
            "id": "3d1884af-06ad-445c-bdb2-b6ad4872beb9",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 180,
            "t1_ms": 1180,
            "t_server_ms": 1780925057021,
            "text": "para esa ma\u00edz."
        },
        {
            "id": "a7b0fd0b-0390-42b7-948e-2079649f0cc4",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2720,
            "t_server_ms": 1780925062045,
            "text": "definidos se debe ver la receta o"
        },
        {
            "id": "a87903be-950d-4041-b58c-fefb13020f91",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 400,
            "t1_ms": 3100,
            "t_server_ms": 1780925067187,
            "text": "no hay destrucciones que nos indicar\u00e1 como debe"
        },
        {
            "id": "e70f24fc-42ba-4eac-bbb6-e54fd1293b1d",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780925072294,
            "text": "experimento con el sistema unido para atr\u00e1s."
        },
        {
            "id": "25802f53-63de-4dbb-bbc7-762f7aec3d53",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3120,
            "t_server_ms": 1780925083705,
            "text": "Esta interacci\u00f3n se denomina calivaci\u00f3n."
        },
        {
            "id": "374146be-2184-4dcd-97d2-8b149e4c9479",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 5000,
            "t_server_ms": 1780925088798,
            "text": "la acci\u00f3n en sistema objeto con el instrumento"
        },
        {
            "id": "3110eebd-4a66-475e-82d7-9bc058c23b1f",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 400,
            "t1_ms": 2400,
            "t_server_ms": 1780925093707,
            "text": "La receta para medir."
        },
        {
            "id": "b3269564-8684-4a8f-b847-1246fc7d2859",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780925099128,
            "text": "de una mesa indicar\u00eda. tome la rela"
        },
        {
            "id": "615671f8-98a8-45d3-b7db-34347b4c7f24",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 3000,
            "t_server_ms": 1780925104433,
            "text": "en coincidencia con el extremo derecho de la..."
        },
        {
            "id": "c90d150b-cab8-470b-9172-91f5c05ec34c",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 340,
            "t1_ms": 2340,
            "t_server_ms": 1780925113733,
            "text": "Also para beber a los"
        },
        {
            "id": "f074c468-80e0-4f36-8c7e-2a593a64a793",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780925122564,
            "text": "\u00a1Honz!"
        },
        {
            "id": "988343f0-37c1-4c52-b5ed-ff0b27288942",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 1000,
            "t_server_ms": 1780925131055,
            "text": "de CCS."
        },
        {
            "id": "3251b609-ee65-41a7-8941-8cb1e4d22767",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 140,
            "t1_ms": 1140,
            "t_server_ms": 1780925142433,
            "text": "\u00bfVenci\u00f3, \u00bfno?"
        },
        {
            "id": "3e0f3f3e-6415-4907-b60f-ca438f5cd71f",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 0,
            "t1_ms": 2000,
            "t_server_ms": 1780925146867,
            "text": "26"
        },
        {
            "id": "264f6429-e5aa-44b4-9207-1cfbe2e565bc",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 340,
            "t1_ms": 2340,
            "t_server_ms": 1780925156685,
            "text": "Mende ciederno."
        },
        {
            "id": "b7283434-78a9-48ea-a4e1-8430dad922bc",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 400,
            "t1_ms": 2400,
            "t_server_ms": 1780925165720,
            "text": "\u00a1Canteos!"
        },
        {
            "id": "b557292d-6ed3-4417-bc3d-41c80dba87e1",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 140,
            "t1_ms": 2140,
            "t_server_ms": 1780925170144,
            "text": "35"
        },
        {
            "id": "59609a12-211a-42fc-8307-d90e9652e00d",
            "is_final": true,
            "source": "faster_whisper",
            "t0_ms": 1010,
            "t1_ms": 3010,
            "t_server_ms": 1780925179432,
            "text": "y deshieda"
        },
        {
            "id": "b5abea19-65d2-4142-aee3-1f841cad0a38",
